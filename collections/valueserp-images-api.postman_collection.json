          "id": "96542e2b-a3a9-49d4-97cd-88f33a567abc",
          "name": "Google Images Search",
          "request": {
            "name": "Google Images Search",
            "description": {
              "content": "Retrieve real-time Google Image search results for a given keyword. Set search_type=images. Returns 100 images per page with filtering by color, size, type, and usage rights.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "search"
              ],
              "hash": "images",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) Your ValueSERP API key. Use \"demo\" for testing limited queries."
                },
                {
                  "disabled": false,
                  "key": "search_type",
                  "value": "<string>",
                  "description": "(Required) Must be set to \"images\"."
                },
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "(Required) The keyword or search query to use."
                },
                {
                  "disabled": false,
                  "key": "location",
                  "value": "<string>",
                  "description": "Geographic location for the search. Accepts location names (e.g., \"manhattan,new york,united states\") or GPS coordinates (e.g., \"lat 43.437677,lon 3.8392765\")."
                },
                {
                  "disabled": false,
                  "key": "location_auto",
                  "value": "true",
                  "description": "When true, automatically updates gl and hl parameters based on the built-in location value. Defaults to true."
                },
                {
                  "disabled": false,
                  "key": "google_domain",
                  "value": "google.com",
                  "description": "The Google domain to use for the search."
                },
                {
                  "disabled": false,
                  "key": "gl",
                  "value": "us",
                  "description": "Determines the Google country to use for the query. ISO 3166-1 alpha-2 country code."
                },
                {
                  "disabled": false,
                  "key": "hl",
                  "value": "en",
                  "description": "Determines the Google UI language to return results in. BCP-47 language code."
                },
                {
                  "disabled": false,
                  "key": "lr",
                  "value": "<string>",
                  "description": "Limits results to pages in the specified language."
                },
                {
                  "disabled": false,
                  "key": "cr",
                  "value": "<string>",
                  "description": "Limits results to pages from the specified country."
                },
                {
                  "disabled": false,
                  "key": "safe",
                  "value": "<string>",
                  "description": "Safe search filter setting."
                },
                {
                  "disabled": false,
                  "key": "tbs",
                  "value": "<string>",
                  "description": "Custom Google TBS parameter value for advanced filtering."
                },
                {
                  "disabled": false,
                  "key": "uule",
                  "value": "<string>",
                  "description": "Custom Google UULE parameter to override the location."
                },
                {
                  "disabled": false,
                  "key": "time_period",
                  "value": "<string>",
                  "description": "Filter results by time period."
                },
                {
                  "disabled": false,
                  "key": "time_period_min",
                  "value": "<string>",
                  "description": "Custom time period start date in MM/DD/YYYY format. Required when time_period=custom."
                },
                {
                  "disabled": false,
                  "key": "time_period_max",
                  "value": "<string>",
                  "description": "Custom time period end date in MM/DD/YYYY format. Required when time_period=custom."
                },
                {
                  "disabled": false,
                  "key": "images_page",
                  "value": "<integer>",
                  "description": "Results page number (100 images per page)."
                },
                {
                  "disabled": false,
                  "key": "images_color",
                  "value": "<string>",
                  "description": "Filter images by color."
                },
                {
                  "disabled": false,
                  "key": "images_size",
                  "value": "<string>",
                  "description": "Filter images by size/dimensions."
                },
                {
                  "disabled": false,
                  "key": "images_type",
                  "value": "<string>",
                  "description": "Filter images by image type/category."
                },
                {
                  "disabled": false,
                  "key": "images_usage",
                  "value": "<string>",
                  "description": "Filter images by usage rights."
                }
              ],
              "variable": []
            },
