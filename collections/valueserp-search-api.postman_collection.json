{
  "item": [
    {
      "id": "ec8b609d-f02f-4c5b-a021-3e0795a125d8",
      "name": "Search",
      "description": {
        "content": "Google organic web search results.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "3891c268-8cbe-46ef-9779-1898fd3329dc",
          "name": "Google Search (Organic)",
          "request": {
            "name": "Google Search (Organic)",
            "description": {
              "content": "Retrieve real-time Google organic search results for a given keyword. Returns organic listings, ads, knowledge graph data, answer boxes, AI overviews, related questions, and more.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) Your ValueSERP API key. Use \"demo\" for testing limited queries."
                },
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "(Required) The keyword or search query to use."
                },
                {
                  "disabled": false,
                  "key": "location",
                  "value": "<string>",
                  "description": "Geographic location for the search. Accepts location names (e.g., \"manhattan,new york,united states\") or GPS coordinates (e.g., \"lat 43.437677,lon 3.8392765\")."
                },
                {
                  "disabled": false,
                  "key": "location_auto",
                  "value": "true",
                  "description": "When true, automatically updates gl and hl parameters based on the built-in location value. Defaults to true."
                },
                {
                  "disabled": false,
                  "key": "google_domain",
                  "value": "google.com",
                  "description": "The Google domain to use for the search."
                },
                {
                  "disabled": false,
                  "key": "gl",
                  "value": "us",
                  "description": "Determines the Google country to use for the query. ISO 3166-1 alpha-2 country code."
                },
                {
                  "disabled": false,
                  "key": "hl",
                  "value": "en",
                  "description": "Determines the Google UI language to return results in. BCP-47 language code."
                },
                {
                  "disabled": false,
                  "key": "lr",
                  "value": "<string>",
                  "description": "Limits results to pages in the specified language."
                },
                {
                  "disabled": false,
                  "key": "cr",
                  "value": "<string>",
                  "description": "Limits results to pages from the specified country."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "The results page number to retrieve. Defaults to 1."
                },
                {
                  "disabled": false,
                  "key": "max_page",
                  "value": "<integer>",
                  "description": "Retrieve multiple result pages in a single API request. Specifies the maximum page number to retrieve."
                },
                {
                  "disabled": false,
                  "key": "safe",
                  "value": "<string>",
                  "description": "Safe search filter setting."
                },
                {
                  "disabled": false,
                  "key": "nfpr",
                  "value": "<integer>",
                  "description": "Exclude auto-corrected spelling results. Set to 1 to exclude, 0 to include (default)."
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "1",
                  "description": "Toggle similar/omitted result filters. 1 enables filtering (default), 0 disables it."
                },
                {
                  "disabled": false,
                  "key": "tbs",
                  "value": "<string>",
                  "description": "Custom Google TBS parameter value for advanced filtering."
                },
                {
                  "disabled": false,
                  "key": "uule",
                  "value": "<string>",
                  "description": "Custom Google UULE parameter to override the location."
                },
                {
                  "disabled": false,
                  "key": "time_period",
                  "value": "<string>",
                  "description": "Filter results by time period."
                },
                {
                  "disabled": false,
                  "key": "time_period_min",
                  "value": "<string>",
                  "description": "Custom time period start date in MM/DD/YYYY format. Required when time_period=custom."
                },
                {
                  "disabled": false,
                  "key": "time_period_max",
                  "value": "<string>",
                  "description": "Custom time period end date in MM/DD/YYYY format. Required when time_period=custom."
                },
                {
                  "disabled": false,
                  "key": "knowledge_graph_id",
                  "value": "<string>",
                  "description": "Specific Google Knowledge Graph entity ID."
                },
                {
                  "disabled": false,
                  "key": "include_ai_overview",
                  "value": "<boolean>",
                  "description": "Adds Google's AI overview content to the response. Costs 1 additional credit when an AI overview is returned."
                },
                {
                  "disabled": false,
                  "key": "include_ai_overview_paa",
                  "value": "<boolean>",
                  "description": "Includes AI overview answers in related questions (People Also Ask). Costs 1 credit per overview."
                },
                {
                  "disabled": false,
                  "key": "include_answer_box",
                  "value": "<boolean>",
                  "description": "When true, includes the featured snippet/answer box as the first item in organic results."
                },
                {
                  "disabled": false,
                  "key": "flatten_results",
                  "value": "<boolean>",
                  "description": "Flattens inline videos, inline images, and other inline content blocks so they appear inline in results."
                },
                {
                  "disabled": false,
                  "key": "fields",
                  "value": "<string>",
                  "description": "Comma-separated list of top-level response objects to return (web-only feature). Reduces response size."
                },
                {
                  "disabled": false,
                  "key": "order_online",
                  "value": "<boolean>",
                  "description": "Returns pickup/delivery ordering info for restaurants (US only). Costs 2 credits instead of 1."
                },
                {
                  "disabled": false,
                  "key": "ads_optimized",
                  "value": "<boolean>",
                  "description": "Optimizes ad return rates in the response. Costs 3 additional credits."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
