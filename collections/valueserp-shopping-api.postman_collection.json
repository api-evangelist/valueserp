      "item": [
        {
          "id": "f753bc1b-489b-4698-ab2e-b62c1b71f127",
          "name": "Google Shopping Search",
          "request": {
            "name": "Google Shopping Search",
            "description": {
              "content": "Retrieve real-time Google Shopping product results for a given keyword. Set search_type=shopping. Supports price filtering, condition, merchant filtering, and sorting.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "search"
              ],
              "hash": "shopping",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) Your ValueSERP API key. Use \"demo\" for testing limited queries."
                },
                {
                  "disabled": false,
                  "key": "search_type",
                  "value": "<string>",
                  "description": "(Required) Must be set to \"shopping\"."
                },
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "(Required) The keyword or search query to use."
                },
                {
                  "disabled": false,
                  "key": "location",
                  "value": "<string>",
                  "description": "Geographic location for the search. Accepts location names (e.g., \"manhattan,new york,united states\") or GPS coordinates (e.g., \"lat 43.437677,lon 3.8392765\")."
                },
                {
                  "disabled": false,
                  "key": "location_auto",
                  "value": "true",
                  "description": "When true, automatically updates gl and hl parameters based on the built-in location value. Defaults to true."
                },
                {
                  "disabled": false,
                  "key": "google_domain",
                  "value": "google.com",
                  "description": "The Google domain to use for the search."
                },
                {
                  "disabled": false,
                  "key": "gl",
                  "value": "us",
                  "description": "Determines the Google country to use for the query. ISO 3166-1 alpha-2 country code."
                },
                {
                  "disabled": false,
                  "key": "hl",
                  "value": "en",
                  "description": "Determines the Google UI language to return results in. BCP-47 language code."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "The results page number to retrieve. Defaults to 1."
                },
                {
                  "disabled": false,
                  "key": "max_page",
                  "value": "<integer>",
                  "description": "Retrieve multiple result pages in a single API request. Specifies the maximum page number to retrieve."
                },
                {
                  "disabled": false,
                  "key": "uule",
                  "value": "<string>",
                  "description": "Custom Google UULE parameter to override the location."
                },
                {
                  "disabled": false,
                  "key": "sort_by",
                  "value": "<string>",
                  "description": "Sort order for shopping results."
                },
                {
                  "disabled": false,
                  "key": "shopping_buy_on_google",
                  "value": "<boolean>",
                  "description": "Include only \"Buy on Google\" products."
                },
                {
                  "disabled": false,
                  "key": "shopping_filter",
                  "value": "<string>",
                  "description": "Filter shopping results by attribute (e.g., brand)."
                },
                {
                  "disabled": false,
                  "key": "shopping_price_min",
                  "value": "<decimal>",
                  "description": "Minimum product price filter."
                },
                {
                  "disabled": false,
                  "key": "shopping_price_max",
                  "value": "<decimal>",
                  "description": "Maximum product price filter."
                },
                {
                  "disabled": false,
                  "key": "shopping_condition",
                  "value": "<string>",
                  "description": "Filter by product condition."
                },
                {
                  "disabled": false,
                  "key": "shopping_merchants",
                  "value": "<string>",
                  "description": "Comma-separated list of merchant IDs to filter results."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
