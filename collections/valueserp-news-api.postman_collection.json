  "item": [
    {
      "id": "30686aff-ebe1-4842-b54a-22f538974bb8",
      "name": "News",
      "description": {
        "content": "Google News article results.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "71eae710-9915-4a14-9544-f7da7f7f61f2",
          "name": "Google News Search",
          "request": {
            "name": "Google News Search",
            "description": {
              "content": "Retrieve real-time Google News results for a given keyword. Set search_type=news. Supports time period filtering, language, country, and sorting.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "search"
              ],
              "hash": "news",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) Your ValueSERP API key. Use \"demo\" for testing limited queries."
                },
                {
                  "disabled": false,
                  "key": "search_type",
                  "value": "<string>",
                  "description": "(Required) Must be set to \"news\"."
                },
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "(Required) The keyword or search query to use."
                },
                {
                  "disabled": false,
                  "key": "location",
                  "value": "<string>",
                  "description": "Geographic location for the search. Accepts location names (e.g., \"manhattan,new york,united states\") or GPS coordinates (e.g., \"lat 43.437677,lon 3.8392765\")."
                },
                {
                  "disabled": false,
                  "key": "location_auto",
                  "value": "true",
                  "description": "When true, automatically updates gl and hl parameters based on the built-in location value. Defaults to true."
                },
                {
                  "disabled": false,
                  "key": "google_domain",
                  "value": "google.com",
                  "description": "The Google domain to use for the search."
                },
                {
                  "disabled": false,
                  "key": "gl",
                  "value": "us",
                  "description": "Determines the Google country to use for the query. ISO 3166-1 alpha-2 country code."
                },
                {
                  "disabled": false,
                  "key": "hl",
                  "value": "en",
                  "description": "Determines the Google UI language to return results in. BCP-47 language code."
                },
                {
                  "disabled": false,
                  "key": "lr",
                  "value": "<string>",
                  "description": "Limits results to pages in the specified language."
                },
                {
                  "disabled": false,
                  "key": "cr",
                  "value": "<string>",
                  "description": "Limits results to pages from the specified country."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "The results page number to retrieve. Defaults to 1."
                },
                {
                  "disabled": false,
                  "key": "max_page",
                  "value": "<integer>",
                  "description": "Retrieve multiple result pages in a single API request. Specifies the maximum page number to retrieve."
                },
                {
                  "disabled": false,
                  "key": "safe",
                  "value": "<string>",
                  "description": "Safe search filter setting."
                },
                {
                  "disabled": false,
                  "key": "nfpr",
                  "value": "<integer>",
                  "description": "Exclude auto-corrected spelling results. Set to 1 to exclude, 0 to include (default)."
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "1",
                  "description": "Toggle similar/omitted result filters. 1 enables filtering (default), 0 disables it."
                },
                {
                  "disabled": false,
                  "key": "tbs",
                  "value": "<string>",
                  "description": "Custom Google TBS parameter value for advanced filtering."
                },
                {
                  "disabled": false,
                  "key": "uule",
                  "value": "<string>",
                  "description": "Custom Google UULE parameter to override the location."
                },
                {
                  "disabled": false,
                  "key": "time_period",
                  "value": "<string>",
                  "description": "Filter results by time period."
                },
                {
                  "disabled": false,
                  "key": "time_period_min",
                  "value": "<string>",
                  "description": "Custom time period start date in MM/DD/YYYY format. Required when time_period=custom."
                },
                {
                  "disabled": false,
                  "key": "time_period_max",
                  "value": "<string>",
                  "description": "Custom time period end date in MM/DD/YYYY format. Required when time_period=custom."
                },
                {
                  "disabled": false,
                  "key": "sort_by",
                  "value": "<string>",
                  "description": "Sort news results by relevance or date."
                },
                {
                  "disabled": false,
                  "key": "show_duplicates",
                  "value": "<boolean>",
                  "description": "Display duplicate results when sort_by=date is used."
                },
                {
                  "disabled": false,
                  "key": "exclude_if_modified",
                  "value": "<boolean>",
                  "description": "Exclude results from queries that were modified by Google."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
