      "item": [
        {
          "id": "fe0b7052-7dca-424a-b9fc-10be67fc6ae3",
          "name": "Google Product Results",
          "request": {
            "name": "Google Product Results",
            "description": {
              "content": "Retrieve Google product listing results for a given product ID. Set search_type=product. Note: This endpoint is deprecated as of October 31 and is being replaced by the Product Details endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "search"
              ],
              "hash": "product",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) Your ValueSERP API key. Use \"demo\" for testing limited queries."
                },
                {
                  "disabled": false,
                  "key": "search_type",
                  "value": "<string>",
                  "description": "(Required) Must be set to \"product\"."
                },
                {
                  "disabled": false,
                  "key": "product_id",
                  "value": "<string>",
                  "description": "(Required) Google product identifier."
                },
                {
                  "disabled": false,
                  "key": "location",
                  "value": "<string>",
                  "description": "Geographic location for the search. Accepts location names (e.g., \"manhattan,new york,united states\") or GPS coordinates (e.g., \"lat 43.437677,lon 3.8392765\")."
                },
                {
                  "disabled": false,
                  "key": "location_auto",
                  "value": "true",
                  "description": "When true, automatically updates gl and hl parameters based on the built-in location value. Defaults to true."
                },
                {
                  "disabled": false,
                  "key": "google_domain",
                  "value": "google.com",
                  "description": "The Google domain to use for the search."
                },
                {
                  "disabled": false,
                  "key": "gl",
                  "value": "us",
                  "description": "Determines the Google country to use for the query. ISO 3166-1 alpha-2 country code."
                },
                {
                  "disabled": false,
                  "key": "hl",
                  "value": "en",
                  "description": "Determines the Google UI language to return results in. BCP-47 language code."
                },
                {
                  "disabled": false,
                  "key": "uule",
                  "value": "<string>",
                  "description": "Custom Google UULE parameter to override the location."
                },
                {
                  "disabled": false,
                  "key": "product_free_shipping",
                  "value": "<boolean>",
                  "description": "Filter to products with free shipping only."
                },
                {
                  "disabled": false,
                  "key": "product_condition_new",
                  "value": "<boolean>",
                  "description": "Filter to new (non-used) products only."
                },
                {
                  "disabled": false,
                  "key": "product_condition_used",
                  "value": "<boolean>",
                  "description": "Filter to used products only."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
